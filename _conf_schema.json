{
  "backend": {
    "description": "默认后端",
    "hint": "command6 为网易云旧逻辑，command9 为落月 API。",
    "type": "string",
    "default": "command9",
    "options": [
      "command9",
      "command6"
    ]
  },
  "render_mode": {
    "description": "歌单展示方式",
    "hint": "image 使用 Pillow 本地 PNG 渲染。",
    "type": "string",
    "default": "text",
    "options": [
      "text",
      "image"
    ]
  },
  "search_list_length": {
    "description": "候选歌曲数量",
    "hint": "当前版本没有分页，这个值就是每次返回多少首候选歌曲。",
    "type": "int",
    "default": 10
  },
  "wait_timeout_seconds": {
    "description": "等待超时(秒)",
    "type": "int",
    "default": 45
  },
  "skip_song_list_selection": {
    "description": "跳过选歌",
    "hint": "开启后不等待输入序号，直接返回第一首歌曲。",
    "type": "bool",
    "default": false
  },
  "exit_words": {
    "description": "退出关键词",
    "hint": "多个关键词用英文逗号分隔。",
    "type": "string",
    "default": "0,不听了,退出"
  },
  "max_duration_seconds": {
    "description": "最长时长(秒)",
    "type": "int",
    "default": 1800
  },
  "output_fields": {
    "description": "详情返回字段",
    "hint": "按顺序配置发送哪些字段，以及每个字段用文本、图片、音频还是文件发送。",
    "type": "template_list",
    "templates": {
      "field": {
        "name": "返回字段",
        "hint": "按顺序配置详情返回内容。",
        "items": {
          "enable": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "data": {
            "description": "字段",
            "type": "string",
            "default": "name",
            "options": [
              "name",
              "artist",
              "platform",
              "album",
              "quality",
              "duration",
              "url",
              "pic",
              "lrc",
              "size",
              "kbps",
              "id"
            ]
          },
          "describe": {
            "description": "标签",
            "type": "string",
            "default": "歌曲"
          },
          "type": {
            "description": "类型",
            "type": "string",
            "default": "text",
            "options": [
              "text",
              "image",
              "audio",
              "file"
            ]
          }
        }
      }
    },
    "default": [
      {
        "__template_key": "field",
        "enable": true,
        "data": "pic",
        "describe": "封面",
        "type": "image"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "name",
        "describe": "歌曲",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "artist",
        "describe": "歌手",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "platform",
        "describe": "平台",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "album",
        "describe": "专辑",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "quality",
        "describe": "音质",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "duration",
        "describe": "时长",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": true,
        "data": "url",
        "describe": "下载链接",
        "type": "text"
      },
      {
        "__template_key": "field",
        "enable": false,
        "data": "lrc",
        "describe": "歌词",
        "type": "text"
      }
    ]
  },
  "download_files_before_send": {
    "description": "文件先下载",
    "hint": "当 output_fields 里使用 file 类型时，先下载到本地再发送。",
    "type": "bool",
    "default": false
  },
  "use_forward_for_primary": {
    "description": "主内容合并转发",
    "hint": "支持的平台上，把主内容包装成转发节点发送。当前建议在 OneBot/Satori 侧测试使用。",
    "type": "bool",
    "default": false
  },
  "enable_music_card": {
    "description": "补发音乐卡片",
    "hint": "在支持的平台上，主内容发送完成后额外补发一张音乐卡片。当前主要面向 OneBot。",
    "type": "bool",
    "default": false
  },
  "separate_media_fields": {
    "description": "媒体拆开发送",
    "hint": "开启后，文本和歌词先一起发，语音和文件后补发。",
    "type": "bool",
    "default": true
  },
  "keep_url_text_for_media": {
    "description": "媒体保留链接",
    "hint": "当 url 字段被配置成 audio/file 时，先发送一条链接文本，再补发语音或文件。",
    "type": "bool",
    "default": true
  },
  "lyric_preview_length": {
    "description": "歌词预览长度",
    "hint": "当字段 data=lrc 且 type=text 时，最多发送多少字符。",
    "type": "int",
    "default": 600
  },
  "svg_theme_color": {
    "description": "主题色",
    "type": "string",
    "default": "#4f7cff"
  },
  "svg_scale": {
    "description": "图片缩放",
    "type": "float",
    "default": 1.8
  },
  "svg_width": {
    "description": "图片宽度",
    "type": "int",
    "default": 760
  },
  "svg_columns": {
    "description": "图片列数",
    "hint": "列数与音乐平台无关；网易、QQ、酷狗混合结果通常推荐 2 列。",
    "type": "int",
    "default": 2
  },
  "svg_column_layout_mode": {
    "description": "歌单填充方式",
    "hint": "row-first 按行从左到右填充；column-first 先从上到下，再填下一列。",
    "type": "string",
    "default": "row-first",
    "options": [
      "row-first",
      "column-first"
    ]
  },
  "svg_dark_mode": {
    "description": "深色歌单",
    "type": "bool",
    "default": false
  },
  "svg_show_dividers": {
    "description": "显示分隔线",
    "type": "bool",
    "default": true
  },
  "svg_show_song_background": {
    "description": "显示歌曲底卡",
    "type": "bool",
    "default": true
  },
  "svg_show_version_info": {
    "description": "显示版本信息",
    "type": "bool",
    "default": true
  },
  "font_path": {
    "description": "字体路径",
    "hint": "留空时会自动尝试系统中文字体。",
    "type": "string",
    "default": ""
  },
  "request_timeout_seconds": {
    "description": "请求超时(秒)",
    "type": "int",
    "default": 20
  },
  "command6_api_urls": {
    "description": "网易 API 地址",
    "hint": "选择用于获取网易云直链的 API。",
    "type": "string",
    "default": "api.injahow.cn",
    "options": [
      "api.injahow.cn",
      "api.qijieya.cn",
      "meting.jmstrand.cn",
      "metingapi.nanorocky.top"
    ]
  },
  "luoyue_api_urls": {
    "description": "落月 API 地址",
    "hint": "选择落月 API；酷狗需要接口支持 /v2/music/kugou。",
    "type": "string",
    "default": "https://api.vkeys.cn",
    "options": [
      "https://api.vkeys.cn",
      "http://xwl.vincentzyu233.cn:51217"
    ]
  },
  "command9_platforms": {
    "description": "落月平台",
    "hint": "可多选；多平台会并行搜索并交替合并。酷狗需使用支持该端点的 API。",
    "type": "list",
    "default": [
      "netease",
      "tencent"
    ],
    "options": [
      "netease",
      "tencent",
      "kugou"
    ]
  },
  "command9_netease_quality": {
    "description": "网易云音质",
    "type": "int",
    "default": 4
  },
  "command9_qq_quality": {
    "description": "QQ 音质",
    "type": "int",
    "default": 8
  },
  "command9_kugou_quality": {
    "description": "酷狗音质",
    "hint": "可选 128、320、flac、high。",
    "type": "string",
    "default": "320",
    "options": [
      "128",
      "320",
      "flac",
      "high"
    ]
  },
  "enable_qq_keyboard": {
    "description": "QQ 官方机器人按钮",
    "hint": "在 QQ 官方机器人平台上发送选歌按钮：一行一个通栏按钮，标签为「序号. 歌名 - 歌手」，每页 4 首，末行为「下一页 / 退出」。",
    "type": "bool",
    "default": true
  },
  "qq_keyboard_callback": {
    "description": "按钮使用回调模式",
    "hint": "开启（推荐）：回调按钮，点一下直接触发，聊天里不会出现你发的序号。关闭：指令按钮，点击会以你的身份发出一条序号消息。若开启后点按钮无反应，说明该部署收不到 interaction 事件，请关闭本项回退。",
    "type": "bool",
    "default": true
  },
  "qq_recall_after_pick": {
    "description": "选完歌后撤回选歌卡片",
    "hint": "开启：点按钮选歌（或发送序号/退出）后，自动撤回那张带按钮的选歌卡片，避免过期按钮留在聊天里被反复点。仅 QQ 官方机器人有效。",
    "type": "bool",
    "default": true
  }
}